# Public README and release media (the generic release/ rule above is kept for
# build trees, but this project's capitalized Release directory is intentional).
!Release/
!Release/*.png
!Release/Screenshots/
!Release/Screenshots/*.png
Release/Screenshots/*.zip

# Timestamped test VPK history. Keep every package; the build script uses cp -n.
!scripts/build/
!scripts/build/vpk/
!scripts/build/vpk/**/
!scripts/build/vpk/**/*.vpk
